# Server
PORT=4000
CLIENT_URL=http://localhost:3000

# Database and authentication
MONGODB_URL=mongodb://127.0.0.1:27017/CodeWaypoint
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary media storage
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
FOLDER_NAME=CodeWaypoint

# Email delivery (see server/utils/mailSender.js for expected configuration)
MAIL_SERVICE=gmail
# Alternatively, set MAIL_HOST, MAIL_PORT, and MAIL_SECURE for custom SMTP.
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_app_password
MAIL_FROM=your_email@example.com

# Razorpay test credentials. Payment routes remain disabled until security review is complete.
RAZORPAY_KEY=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_key_secret
